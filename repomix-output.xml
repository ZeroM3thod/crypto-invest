                </AnimatedSidebarMenuItem>
                <AnimatedSidebarMenuItem>
                  <AnimatedSidebarMenuButton
                    icon={<Sparkles className="size-4" />}
                    onSelect={() => setActive("AI Assistant")}
                  >
                    AI Assistant
                  </AnimatedSidebarMenuButton>
                </AnimatedSidebarMenuItem>
                <AnimatedSidebarMenuItem>
                  <AnimatedSidebarMenuButton
                    icon={<Inbox className="size-4" />}
                    badge="4"
                    onSelect={() => setActive("Inbox")}
                  >
