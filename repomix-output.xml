              <span className="text-xs text-muted-foreground">Active (visible to users)</span>
              <Toggle checked={form.active} onChange={(v) => set("active", v)} label="Active" />
            </div>
            {error && <p className="text-xs font-medium text-destructive">{error}</p>}
          </div>
        )}
      </Modal>
    </AdminShell>
  );
}
