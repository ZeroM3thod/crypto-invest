          {top20.map((entry) => {
            const prize = prizeForRank(entry.rank, prizes);
            return (
              <div
                key={entry.userId}
                className={[
                  "flex items-center justify-between rounded-2xl border p-3.5 transition-colors",
                  entry.isCurrentUser
                    ? "border-foreground bg-foreground/5"
                    : entry.rank <= 3
                    ? "border-foreground/30 bg-muted/20"
                    : "border-border",
