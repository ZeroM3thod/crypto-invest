  :root {
    --tv-bg:          #F2DFCE;
    --tv-panel:       #E8D0BB;
    --tv-border:      #D1BEAE;
    --tv-text:        #43444F;
    --tv-text-dim:    #9598A1;
    --tv-text-bright: #2a2b33;
    --tv-green:       #0D7680;
    --tv-red:         #43444F;
    --tv-accent:      #0D7680;
    --tv-hover:       rgba(13,118,128,.1);
    --tv-toolbar-h:   38px;
    --tv-status-h:    32px;
    box-sizing: border-box;
  }
  *, *::before, *::after { box-sizing: inherit; margin: 0; padding: 0; }

  html, body {
    width: 100%; height: 100%;
    background: var(--tv-bg);
    font-family: -apple-system, BlinkMacSystemFont, 'Trebuchet MS', Roboto, Ubuntu, sans-serif;
    color: var(--tv-text);
    overflow: hidden;
    user-select: none;
  }

  #toolbar {
    display: flex; align-items: center;
    height: var(--tv-toolbar-h);
    background: var(--tv-panel);
    border-bottom: 1px solid var(--tv-border);
    padding: 0 8px; gap: 2px; flex-shrink: 0;
  }
  .tv-divider {
    width: 1px; height: 20px;
    background: var(--tv-border);
    margin: 0 4px; flex-shrink: 0;
  }
  .tb-btn {
    display: flex; align-items: center; gap: 4px;
    height: 28px; padding: 0 7px;
    border-radius: 4px; border: none;
    background: transparent; color: var(--tv-text-dim);
    font-size: 12px; font-weight: 500;
    cursor: pointer; white-space: nowrap;
    transition: background .15s, color .15s;
  }
  .tb-btn:hover  { background: var(--tv-hover); color: var(--tv-text-bright); }
  .tb-btn.active { background: rgba(13,118,128,.15); color: var(--tv-accent); }
  .tb-btn svg    { flex-shrink: 0; }

  #sym-block { display: flex; align-items: center; gap: 6px; padding: 0 6px; }
  #sym-logo {
    width: 22px; height: 22px;
    background: linear-gradient(135deg,#f7931a,#f5a623);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; color:#fff; flex-shrink:0;
  }
  #sym-name { font-size:14px; font-weight:600; color:var(--tv-text-bright); cursor:pointer; }
  #sym-name:hover { color:#000; }
  #sym-ex { font-size:10px; color:var(--tv-text-dim); }

  .iv-btn {
    height:26px; padding:0 6px; border-radius:3px; border:none;
    background:transparent; color:var(--tv-text-dim);
    font-size:12px; font-weight:500; cursor:pointer;
    transition: background .15s, color .15s;
  }
  .iv-btn:hover  { background:var(--tv-hover); color:var(--tv-text-bright); }
  .iv-btn.active { background:rgba(13,118,128,.18); color:var(--tv-accent); }

  #statusbar {
    display:flex; align-items:center;
    height:var(--tv-status-h); padding:0 10px; gap:10px;
    font-size:12px; background:var(--tv-panel);
    border-bottom:1px solid var(--tv-border); flex-shrink:0;
  }
  #ohlc-sym { font-weight:600; color:var(--tv-text-bright); font-size:12px; }
  .ohlc-label { color:var(--tv-text-dim); }
  .ohlc-val   { color:var(--tv-text-bright); }
  .ohlc-val.green { color:#0D7680; }
  .ohlc-val.red   { color:#43444F; font-weight:600; }
  #ohlc-change { font-weight:500; }

  #live-badge {
    display:flex; align-items:center; gap:4px;
    background:rgba(13,118,128,.12);
    border:1px solid rgba(13,118,128,.35);
    border-radius:3px; padding:1px 6px;
    font-size:10px; font-weight:600; color:#0D7680;
    margin-left:4px;
  }
  #live-dot {
    width:6px; height:6px; border-radius:50%;
    background:#0D7680;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

  #left-bar {
    position:absolute; left:0;
    top:calc(var(--tv-toolbar-h) + var(--tv-status-h));
    bottom:0; width:44px;
    background:var(--tv-panel);
    border-right:1px solid var(--tv-border);
    display:flex; flex-direction:column;
    align-items:center; padding-top:6px; gap:2px;
    z-index:10;
  }
  .draw-btn {
    width:34px; height:34px; border-radius:4px; border:none;
    background:transparent; color:var(--tv-text-dim); cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:background .15s, color .15s;
  }
  .draw-btn:hover  { background:var(--tv-hover); color:var(--tv-text-bright); }
  .draw-btn.active { background:rgba(13,118,128,.15); color:var(--tv-accent); }
  .draw-sep { width:20px; height:1px; background:var(--tv-border); margin:4px 0; }

  #chart-area {
    position:absolute; left:44px;
    top:calc(var(--tv-toolbar-h) + var(--tv-status-h));
    right:0; bottom:0;
    background:var(--tv-bg); overflow:hidden;
  }
  #tv-chart { width:100%; height:100%; }

  #legend {
    position:absolute; top:6px; left:8px;
    font-size:11px; color:var(--tv-text-dim);
    pointer-events:none; z-index:15;
    display:flex; flex-direction:column; gap:2px;
  }
  #legend-sym { font-size:13px; font-weight:600; color:var(--tv-text-bright); }

  #watermark {
    position:absolute; top:50%; left:50%;
    transform:translate(-50%,-50%);
    font-size:56px; font-weight:700;
    color:rgba(67,68,79,.06);
    letter-spacing:2px; pointer-events:none;
    white-space:nowrap; user-select:none; z-index:1;
  }

  #vol-label {
    position:absolute; bottom:28px; left:10px;
    font-size:10px; color:var(--tv-text-dim);
    pointer-events:none; z-index:15;
  }
  #ind-labels { display:none; }
</style>
</head>
<body>

<div id="toolbar">
  <div id="sym-block">
    <div id="sym-logo">₿</div>
    <div>
      <div id="sym-name">BTCUSDT <span style="font-size:10px;color:var(--tv-text-dim)">▾</span></div>
      <div id="sym-ex">BINANCE</div>
    </div>
  </div>
  <div class="tv-divider"></div>
  <button class="iv-btn" data-iv="1m">1m</button>
  <button class="iv-btn" data-iv="5m">5m</button>
  <button class="iv-btn" data-iv="15m">15m</button>
  <button class="iv-btn" data-iv="1h">1H</button>
  <button class="iv-btn active" data-iv="4h">4H</button>
