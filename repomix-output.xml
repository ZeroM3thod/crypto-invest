      </div>
    );
  return (
    <div className="flex size-9 shrink-0 items-center justify-center rounded-full border border-border text-sm font-semibold text-muted-foreground">
      {rank}
    </div>
  );
}

function PrizeTag({ amount }: { amount: number }) {
