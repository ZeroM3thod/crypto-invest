  </button>
  <button class="tb-btn" title="Settings">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
      <circle cx="7" cy="7" r="2"/>
      <path d="M7 1v1.5M7 11.5V13M1 7h1.5M11.5 7H13M2.9 2.9l1.06 1.06M10.04 10.04l1.06 1.06M11.1 2.9L10.04 3.96M3.96 10.04L2.9 11.1" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<div id="statusbar">
  <span id="ohlc-sym">BTCUSDT · 4H</span>
  <div id="live-badge"><div id="live-dot"></div>LIVE</div>
  <span class="ohlc-label">O</span><span class="ohlc-val" id="ohlc-o">—</span>
  <span class="ohlc-label">H</span><span class="ohlc-val green" id="ohlc-h">—</span>
  <span class="ohlc-label">L</span><span class="ohlc-val red" id="ohlc-l">—</span>
