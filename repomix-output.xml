<div id="chart-area">
  <div id="watermark">BTCUSDT</div>
  <div id="tv-chart"></div>
  <div id="legend"><span id="legend-sym">BTC/USDT · 4H</span></div>
  <div id="ind-labels"></div>
  <div id="vol-label">Volume</div>
</div>

<script>
function genHistory(count) {
  const phases = [
    { start:52000, end:73000, bars:90 },
    { start:73000, end:56000, bars:60 },
    { start:56000, end:68000, bars:50 },
    { start:68000, end:61000, bars:40 },
    { start:61000, end:67000, bars:29 },
  ];
  const candles = [];
  let price = 52000;
  let ts = Math.floor(new Date('2024-03-01').getTime()/1000);
  const FOUR_H = 4*3600;
  let pi=0, pb=0;
  for (let i=0;i<count;i++) {
    const ph = phases[Math.min(pi,phases.length-1)];
    const trend = (ph.end - ph.start)/ph.bars;
    const vol   = price * 0.012;
    const open  = price;
    const move  = trend + (Math.random()-.42)*vol;
    const close = open + move;
    const wick  = Math.abs(move)*(0.5+Math.random());
    const high  = Math.max(open,close)+Math.random()*wick*0.6;
    const low   = Math.min(open,close)-Math.random()*wick*0.6;
    const volume= 800+Math.random()*3000+Math.abs(move/price)*80000;
    candles.push({
      time: ts,
      open:  +open.toFixed(2), high:  +high.toFixed(2),
      low:   +low.toFixed(2),  close: +close.toFixed(2),
      volume:+volume.toFixed(0)
    });
    price = close; ts += FOUR_H; pb++;
    if (pb >= ph.bars){ pi++; pb=0; }
  }
  return candles;
}

const HISTORY = genHistory(269);
const FOUR_H  = 4*3600;

const chartEl   = document.getElementById('tv-chart');
const chartArea = document.getElementById('chart-area');

const chart = LightweightCharts.createChart(chartEl, {
  width:  chartArea.clientWidth,
  height: chartArea.clientHeight,
  layout: {
    background: { type:'solid', color:'#F2DFCE' },
    textColor:  '#9598A1',
    fontSize: 11,
    fontFamily: "-apple-system,BlinkMacSystemFont,'Trebuchet MS',Roboto,sans-serif",
  },
  grid: {
    vertLines: { color:'#E0CCBB', style:0 },
    horzLines: { color:'#E0CCBB', style:0 },
  },
  crosshair: {
    mode: LightweightCharts.CrosshairMode.Normal,
    vertLine: { color:'#9598A1', width:1, style:3, labelBackgroundColor:'#D1BEAE' },
    horzLine: { color:'#9598A1', width:1, style:3, labelBackgroundColor:'#D1BEAE' },
  },
  rightPriceScale: {
    borderColor: '#D1BEAE',
    textColor:   '#9598A1',
    scaleMargins:{ top:0.08, bottom:0.22 },
  },
  timeScale: {
    borderColor: '#D1BEAE',
    textColor:   '#9598A1',
    timeVisible: true,
    secondsVisible: false,
  },
  handleScroll: { mouseWheel:true, pressedMouseMove:true },
  handleScale:  { mouseWheel:true, pinch:true },
});

// Candles — teal up, charcoal down
const candleSeries = chart.addCandlestickSeries({
  upColor:        '#0D7680',
  downColor:      '#43444F',
  borderUpColor:  '#0D7680',
  borderDownColor:'#43444F',
  wickUpColor:    '#0D7680',
  wickDownColor:  '#43444F',
});
candleSeries.setData(HISTORY);

// Volume
const volumeSeries = chart.addHistogramSeries({
  priceFormat:  { type:'volume' },
  priceScaleId: 'vol',
  scaleMargins: { top:0.82, bottom:0 },
});
volumeSeries.setData(HISTORY.map(c=>({
  time:  c.time,
  value: c.volume,
  color: c.close>=c.open ? 'rgba(13,118,128,0.4)':'rgba(67,68,79,0.35)'
})));
chart.priceScale('vol').applyOptions({
  scaleMargins:{ top:0.82, bottom:0 },
  borderVisible:false,
});

chart.timeScale().fitContent();

// ── LIVE TICKING ──
let lastCandle = { ...HISTORY[HISTORY.length-1] };
let liveCandle = null;
const TICK_MS = 800, TICKS_PER_CANDLE = 80;
let tickCount = 0;
let livePrice = lastCandle.close;
let liveTrend = (Math.random()-0.5)*60;

function nextTick() {
  const volatility = livePrice * 0.0015;
  const change = liveTrend*0.01 + (Math.random()-0.48)*volatility;
  livePrice = Math.max(livePrice+change, 1000);
  if (Math.random()<0.05) liveTrend=(Math.random()-0.5)*120;

  if (!liveCandle) {
    liveCandle = { time:lastCandle.time+FOUR_H, open:livePrice, high:livePrice, low:livePrice, close:livePrice, volume:0 };
  }
  liveCandle.close  = +livePrice.toFixed(2);
  liveCandle.high   = +Math.max(liveCandle.high,livePrice).toFixed(2);
  liveCandle.low    = +Math.min(liveCandle.low,livePrice).toFixed(2);
  liveCandle.volume += 20+Math.random()*80;

  candleSeries.update(liveCandle);
  volumeSeries.update({
    time:liveCandle.time, value:liveCandle.volume,
    color:liveCandle.close>=liveCandle.open?'rgba(13,118,128,0.4)':'rgba(67,68,79,0.35)'
  });
  if (!crosshairTime||crosshairTime===liveCandle.time) displayOHLC(liveCandle);

  tickCount++;
  if (tickCount>=TICKS_PER_CANDLE) {
    lastCandle={...liveCandle}; liveCandle=null; tickCount=0; livePrice=lastCandle.close;
  }
}
setInterval(nextTick, TICK_MS);

// ── OHLC BAR ──
const ohlcO=document.getElementById('ohlc-o'), ohlcH=document.getElementById('ohlc-h'),
      ohlcL=document.getElementById('ohlc-l'), ohlcC=document.getElementById('ohlc-c'),
      ohlcChg=document.getElementById('ohlc-change'), ohlcV=document.getElementById('ohlc-v');

function fmt(n)    { return n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtVol(n) { return n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':n.toFixed(0); }

function displayOHLC(c) {
  if (!c) return;
  ohlcO.textContent=fmt(c.open); ohlcH.textContent=fmt(c.high);
  ohlcL.textContent=fmt(c.low);  ohlcC.textContent=fmt(c.close);
  const diff=c.close-c.open, pct=(diff/c.open*100).toFixed(2), pos=diff>=0;
  ohlcChg.textContent=`${pos?'+':''}${diff.toFixed(2)} (${pos?'+':''}${pct}%)`;
  ohlcChg.className=`ohlc-val ${pos?'green':'red'}`;
  ohlcV.textContent=fmtVol(c.volume);
}

const candleMap=new Map(HISTORY.map(c=>[c.time,c]));
let crosshairTime=null;
displayOHLC(HISTORY[HISTORY.length-1]);

chart.subscribeCrosshairMove(param=>{
  if (!param||!param.time){ crosshairTime=null; displayOHLC(liveCandle||lastCandle); return; }
  crosshairTime=param.time;
  if (liveCandle&&param.time===liveCandle.time) displayOHLC(liveCandle);
  else { const c=candleMap.get(param.time); if(c) displayOHLC(c); }
});

// ── CHART TYPE ──
let lineSeries=null, areaSeries=null;
function setChartType(type){
  ['btn-candle','btn-line','btn-area'].forEach(id=>document.getElementById(id).classList.toggle('active',id===`btn-${type}`));
  if(type==='candle'){
    candleSeries.applyOptions({visible:true});
    if(lineSeries) lineSeries.applyOptions({visible:false});
    if(areaSeries) areaSeries.applyOptions({visible:false});
  } else if(type==='line'){
    candleSeries.applyOptions({visible:false});
    if(areaSeries) areaSeries.applyOptions({visible:false});
    if(!lineSeries){ lineSeries=chart.addLineSeries({color:'#0D7680',lineWidth:2,priceLineVisible:false,lastValueVisible:false}); lineSeries.setData(HISTORY.map(c=>({time:c.time,value:c.close}))); }
    else lineSeries.applyOptions({visible:true});
  } else if(type==='area'){
    candleSeries.applyOptions({visible:false});
    if(lineSeries) lineSeries.applyOptions({visible:false});
    if(!areaSeries){ areaSeries=chart.addAreaSeries({topColor:'rgba(13,118,128,.3)',bottomColor:'rgba(13,118,128,0)',lineColor:'#0D7680',lineWidth:2,priceLineVisible:false,lastValueVisible:false}); areaSeries.setData(HISTORY.map(c=>({time:c.time,value:c.close}))); }
    else areaSeries.applyOptions({visible:true});
  }
}
document.getElementById('btn-candle').addEventListener('click',()=>setChartType('candle'));
document.getElementById('btn-line').addEventListener('click',()=>setChartType('line'));
document.getElementById('btn-area').addEventListener('click',()=>setChartType('area'));

// ── INTERVAL SWITCHER ──
document.querySelectorAll('.iv-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.iv-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const iv=btn.dataset.iv;
    document.getElementById('ohlc-sym').textContent=`BTCUSDT · ${iv}`;
    document.getElementById('legend-sym').textContent=`BTC/USDT · ${iv}`;
  });
});

// ── DRAWING TOOLBAR ──
document.querySelectorAll('.draw-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.draw-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
  });
});

// ── RESIZE ──
new ResizeObserver(()=>{
  chart.applyOptions({width:chartArea.clientWidth,height:chartArea.clientHeight});
}).observe(chartArea);
</script>
</body>
</html>
</file>

