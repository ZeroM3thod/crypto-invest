              <p className="text-sm text-muted-foreground sm:text-right">
                Total profit shown:{" "}
                <span className="font-semibold tabular-nums text-emerald-500">{usd(filteredProfitTotal)}</span>
              </p>
            </div>
            <Grid data={filteredProfits} columns={profitCols} height={380} />
